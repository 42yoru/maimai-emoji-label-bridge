{
  "manifest_version": 2,
  "version": "0.2.0",
  "plugin_type": "media",
  "name": "表情标签桥接 (Emoji Label Bridge)",
  "description": "把回复正文里模型凭空写出的「[表情包: 标签]」接成真表情：精确描述 → 本地标签重叠 → 嵌入模型兜底，全部未命中时按配置删除标签。发送层实现，旧 reply 工具与被动式 replyer 都通用，不改主程序。",
  "author": {
    "name": "42yoru",
    "url": "https://github.com/42yoru"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/42yoru/maimai-emoji-label-bridge",
    "homepage": "https://github.com/42yoru/maimai-emoji-label-bridge",
    "documentation": "https://github.com/42yoru/maimai-emoji-label-bridge/blob/main/README.md",
    "issues": "https://github.com/42yoru/maimai-emoji-label-bridge/issues"
  },
  "host_application": {
    "min_version": "1.3.15",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.12.0",
    "max_version": "2.50.50"
  },
  "dependencies": [],
  "capabilities": [
    "database.query",
    "llm.embed"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "github.42yoru.maimai-emoji-label-bridge",
  "changelog": "CHANGELOG.md",
  "display": {
    "icon": {
      "type": "local",
      "value": "icon.png",
      "fallback": "smile",
      "background": "#FEC872"
    }
  }
}
